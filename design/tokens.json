{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Northwind Design Tokens",
  "version": "1.0.0",
  "brand": {
    "name": "Northwind",
    "tagline": "AI-powered quantitative trading workstation",
    "domain": "northwind.ai",
    "legalName": "Northwind Trading Technologies Inc."
  },
  "color": {
    "dark": {
      "appCanvas": "#08090c",
      "appWidgetContentBg": "#0d1017",
      "appWidgetInnerBg": "#131822",
      "tertiarySurfaceBg": "#161b26",
      "tertiarySurfaceBorder": "#262f3e",
      "appPanelBorder": "#1e2532",
      "astralPrimary": "#0052ff",
      "astralBlue700": "#1d4ed8",
      "astralBlue800": "#1e40af",
      "astral70": "#94a3b8",
      "astral50": "#64748b",
      "astral30": "#334155",
      "astral20": "#1e293b",
      "astral15": "#0f172a",
      "astral10": "#090d16",
      "text": "#ffffff",
      "textSecondary": "#94a3b8",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "light": {
      "appCanvas": "#f8fafc",
      "appWidgetContentBg": "#ffffff",
      "appWidgetInnerBg": "#f1f5f9",
      "tertiarySurfaceBg": "#e2e8f0",
      "tertiarySurfaceBorder": "#cbd5e1",
      "appPanelBorder": "#e2e8f0",
      "astralPrimary": "#2563eb",
      "astralBlue700": "#1d4ed8",
      "astralBlue800": "#1e40af",
      "astral70": "#475569",
      "astral50": "#64748b",
      "astral30": "#cbd5e1",
      "astral20": "#e2e8f0",
      "astral15": "#f1f5f9",
      "astral10": "#f8fafc",
      "text": "#0f172a",
      "textSecondary": "#475569",
      "success": "#16a34a",
      "warning": "#d97706",
      "error": "#dc2626",
      "info": "#2563eb"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "var(--font-geist-sans), Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "var(--font-geist-mono), 'JetBrains Mono', 'SF Mono', Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": { "size": "0.75rem", "lineHeight": "1rem" },
      "sm": { "size": "0.875rem", "lineHeight": "1.25rem" },
      "base": { "size": "1rem", "lineHeight": "1.5rem" },
      "lg": { "size": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "size": "1.25rem", "lineHeight": "1.75rem" },
      "2xl": { "size": "1.5rem", "lineHeight": "2rem" },
      "3xl": { "size": "1.875rem", "lineHeight": "2.25rem" },
      "4xl": { "size": "2.25rem", "lineHeight": "2.5rem" },
      "5xl": { "size": "3rem", "lineHeight": "1" },
      "6xl": { "size": "3.75rem", "lineHeight": "1" }
    },
    "fontWeight": {
      "light": "300",
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem",
    "32": "8rem"
  },
  "borderRadius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "glowBlue": "0 0 25px rgba(59, 130, 246, 0.25)",
    "glowRainbow": "0 0 20px rgba(142, 197, 255, 0.4)"
  },
  "transitions": {
    "fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
    "normal": "200ms cubic-bezier(0.4, 0, 0.2, 1)",
    "slow": "300ms cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
